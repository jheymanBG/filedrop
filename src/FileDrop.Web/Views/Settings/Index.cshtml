@model FileDrop.Web.Models.SettingsViewModel

<section class="admin-shell">
    <aside class="admin-nav">
        <h2>FileDrop Admin</h2>
        <a href="/Admin">Dashboard</a>
        <a href="/Admin/Transfers">Transfers</a>
        <a href="/Admin/Audit">Audit Log</a>
        <a href="/Admin/Health">Health</a>
        <a class="active" href="/Admin/Settings">Settings</a>
        <a href="/">User Home</a><form method="post" action="/Admin/Logout" class="admin-logout-form"><button type="submit">Admin Logout</button></form>
    </aside>

    <div class="admin-main">
        <h1>Settings</h1>

        @if (TempData["Message"] is not null)
        {
            <div class="notice">@TempData["Message"]</div>
        }

        <div class="admin-card">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Setting</th>
                        <th>Value</th>
                        <th>Description</th>
                        <th>Modified</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Settings)
                {
                    <tr>
                        <form method="post" action="/Admin/Settings">
                            <td>
                                <strong>@s.SettingKey</strong>
                                <input type="hidden" name="key" value="@s.SettingKey" />
                            </td>
                            <td><input name="value" value="@s.SettingValue" /></td>
                            <td>@s.Description</td>
                            <td>@s.ModifiedDate.ToLocalTime()</td>
                            <td><button type="submit">Save</button></td>
                        </form>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>








