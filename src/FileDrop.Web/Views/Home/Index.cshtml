@inject FileDrop.Web.Services.IBrandingService BrandingService
@{
    var branding = await BrandingService.GetAsync();
}

<section class="hero upgraded-hero">
    <div class="hero-copy">
        <div class="eyebrow">@branding.DepartmentName</div>
        <h1>Send large files securely.</h1>
        <p>FileDrop provides a simple way to send project files, maps, photos, plans, and GIS data using secure download links with expiration dates.</p>

        <div class="hero-actions">
            <a class="button" href="/Transfer/Create">New Transfer</a>
            <a class="button secondary-button" href="/Home/Help">How it works</a>
        </div>

        <p class="muted small-note">Microsoft 365 sign-in can be enabled after Entra admin consent is granted. Temporary local upload mode is currently available.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(branding.LogoPath))
    {
        <div class="logo-placeholder">
            <div class="logo-box logo-box-real">
                <img src="@branding.LogoPath" alt="@branding.OrganizationName logo" />
            </div>
        </div>
    }
</section>

<section class="card info-card">
    <h2>How it works</h2>
    <div class="steps">
        <div><span>1</span><strong>Select files</strong><p>Drag and drop one or more files into FileDrop.</p></div>
        <div><span>2</span><strong>Set expiration</strong><p>Choose how long the download link remains active.</p></div>
        <div><span>3</span><strong>Send link</strong><p>The recipient receives an email with a secure download link.</p></div>
    </div>
</section>
