@model FileDrop.Web.Models.AdminDashboardViewModel
@{
    string Size(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.##} {units[unit]}";
    }

    var freeClass = Model.StorageDriveFreePercent <= 10 ? "danger" : Model.StorageDriveFreePercent <= 20 ? "warning" : "active";
    var usedPercent = Model.StorageDriveTotalBytes <= 0 ? 0 : Math.Round((double)Model.StorageDriveUsedBytes / Model.StorageDriveTotalBytes * 100, 1);
}

<section class="admin-shell">
    <aside class="admin-nav">
        <h2>FileDrop Admin</h2>
        <a class="active" href="/Admin">Dashboard</a>
        <a href="/Admin/Transfers">Transfers</a><a href="/Admin/Audit">Audit Log</a><a href="/Admin/Health">Health</a><a href="/Admin/Settings">Settings</a><a href="/Admin/AdminUsers">Admin Users</a><a href="/Admin/Uploads">Upload Manager</a><a href="/Admin/Deployment">Deployment</a><a href="/Admin/Reports">Reports</a><a href="/Admin/Email">Email Test</a><a href="/Admin/Branding">Branding</a><a href="/Admin/Entra">Entra Readiness</a><a href="/Admin/Production">Production</a><a href="/Admin/Security">Security</a><a href="/Admin/Authorization">Authorization</a>
        <a href="/">User Home</a><form method="post" action="/Admin/Logout" class="admin-logout-form"><button type="submit">Admin Logout</button></form>
    </aside>

    <div class="admin-main">
        <h1>Dashboard</h1>
        @if (TempData["Message"] is not null)
        {
            <div class="notice">@TempData["Message"]</div>
        }
        <form method="post" action="/Admin/CleanupExpired" class="cleanup-form"><input type="number" name="olderThanDays" value="0" min="0" max="365" /><button type="submit" class="warning">Delete Expired Transfers</button></form>

        <div class="metric-grid">
            <div class="metric"><span>Active Transfers</span><strong>@Model.ActiveTransfers</strong></div>
            <div class="metric"><span>Expired Transfers</span><strong>@Model.ExpiredTransfers</strong></div>
            <div class="metric"><span>Total Files</span><strong>@Model.TotalFiles</strong></div>
            <div class="metric"><span>Storage Used by FileDrop</span><strong>@Size(Model.TotalStorageBytes)</strong></div>
            <div class="metric"><span>Total Downloads</span><strong>@Model.DownloadsTotal</strong></div>
            <div class="metric"><span>Total Transfers</span><strong>@Model.TotalTransfers</strong></div>
        </div>

        <div class="admin-card" style="margin-top:18px;">
            <div class="card-title-row">
                <div>
                    <h2>Live Storage Space</h2>
                    <p class="muted" style="margin:4px 0 0;">Drive monitored for FileDrop storage: <strong>@Model.StorageRoot</strong></p>
                </div>
                <span id="storageStatusBadge" class="badge @freeClass">@Model.StorageDriveFreePercent.ToString("0.#")% free</span>
            </div>

            <div class="metric-grid" style="margin-top:16px;">
                <div class="metric"><span>Drive</span><strong id="storageDrive">@Model.StorageDriveName</strong></div>
                <div class="metric"><span>Free Space</span><strong id="storageFree">@Size(Model.StorageDriveFreeBytes)</strong></div>
                <div class="metric"><span>Used Space</span><strong id="storageUsed">@Size(Model.StorageDriveUsedBytes)</strong></div>
                <div class="metric"><span>Total Capacity</span><strong id="storageTotal">@Size(Model.StorageDriveTotalBytes)</strong></div>
            </div>

            <div style="margin-top:16px;height:18px;border-radius:999px;background:#e5ece7;overflow:hidden;">
                <div id="storageUsedBar" style="height:100%;width:@usedPercent%;background:#0f5f3f;border-radius:999px;transition:width .3s ease;"></div>
            </div>
            <p class="muted" style="margin-top:10px;">Last checked: <span id="storageCheckedAt">@Model.StorageCheckedAt.ToLocalTime()</span>. Updates every 30 seconds while this page is open.</p>
        </div>

        <div class="admin-card">
            <div class="card-title-row">
                <h2>Recent Transfers</h2>
                <a href="/Admin/Transfers">View all</a>
            </div>
            <table class="admin-table">
                <thead>
                    <tr><th>Subject</th><th>Sender</th><th>Recipient</th><th>Files</th><th>Size</th><th>Expires</th><th>Status</th></tr>
                </thead>
                <tbody>
                @foreach (var t in Model.RecentTransfers)
                {
                    <tr>
                        <td><a href="/Admin/Transfer/@t.TransferId">@(string.IsNullOrWhiteSpace(t.Subject) ? "(No subject)" : t.Subject)</a></td>
                        <td>@t.SenderEmail</td>
                        <td>@t.RecipientEmail</td>
                        <td>@t.FileCount</td>
                        <td>@Size(t.TotalBytes)</td>
                        <td>@t.ExpirationDate.ToLocalTime()</td>
                        <td><span class="badge @t.Status.ToLowerInvariant()">@t.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="admin-card">
            <h2>Largest Files</h2>
            <table class="admin-table">
                <thead>
                    <tr><th>File</th><th>Recipient</th><th>Size</th><th>Uploaded</th></tr>
                </thead>
                <tbody>
                @foreach (var f in Model.LargestFiles)
                {
                    <tr>
                        <td>@f.OriginalFileName</td>
                        <td>@f.RecipientEmail</td>
                        <td>@Size(f.FileSizeBytes)</td>
                        <td>@f.UploadedDate.ToLocalTime()</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
(function () {
    const size = (bytes) => {
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        let value = Number(bytes || 0);
        let unit = 0;
        while (value >= 1024 && unit < units.length - 1) {
            value /= 1024;
            unit++;
        }
        return `${value.toFixed(value >= 10 || unit === 0 ? 0 : 2)} ${units[unit]}`;
    };

    async function refreshStorage() {
        try {
            const response = await fetch('/Admin/StorageStatus', { cache: 'no-store' });
            if (!response.ok) return;
            const data = await response.json();
            const total = Number(data.totalBytes || 0);
            const used = Number(data.usedBytes || 0);
            const freePercent = Number(data.freePercent || 0);
            const usedPercent = total > 0 ? Math.max(0, Math.min(100, used / total * 100)) : 0;

            document.getElementById('storageDrive').textContent = data.drive || 'Unknown';
            document.getElementById('storageFree').textContent = size(data.freeBytes);
            document.getElementById('storageUsed').textContent = size(data.usedBytes);
            document.getElementById('storageTotal').textContent = size(data.totalBytes);
            document.getElementById('storageUsedBar').style.width = `${usedPercent.toFixed(1)}%`;
            document.getElementById('storageCheckedAt').textContent = new Date(data.checkedAt).toLocaleString();

            const badge = document.getElementById('storageStatusBadge');
            badge.textContent = `${freePercent.toFixed(1)}% free`;
            badge.className = `badge ${freePercent <= 10 ? 'danger' : freePercent <= 20 ? 'warning' : 'active'}`;
        } catch { }
    }

    setInterval(refreshStorage, 30000);
})();
</script>
