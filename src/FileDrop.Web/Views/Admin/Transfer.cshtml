@model FileDrop.Web.Models.AdminTransferDetailViewModel
@{
    string Size(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.##} {units[unit]}";
    }
}

<section class="admin-shell">
    <aside class="admin-nav">
        <h2>FileDrop Admin</h2>
        <a href="/Admin">Dashboard</a>
        <a href="/Admin/Transfers">Transfers</a><a href="/Admin/Audit">Audit Log</a><a href="/Admin/Health">Health</a><a href="/Admin/Settings">Settings</a><a href="/Admin/AdminUsers">Admin Users</a><a href="/Admin/Uploads">Upload Manager</a><a href="/Admin/Deployment">Deployment</a><a href="/Admin/Reports">Reports</a><a href="/Admin/Email">Email Test</a><a href="/Admin/Branding">Branding</a><a href="/Admin/Entra">Entra Readiness</a><a href="/Admin/Production">Production</a><a href="/Admin/Security">Security</a><a href="/Admin/Authorization">Authorization</a>
        <a href="/">User Home</a><form method="post" action="/Admin/Logout" class="admin-logout-form"><button type="submit">Admin Logout</button></form>
    </aside>

    <div class="admin-main">
        <a href="/Admin/Transfers" class="secondary-link">Back to transfers</a>
        <h1>@(string.IsNullOrWhiteSpace(Model.Transfer.Subject) ? "Transfer Detail" : Model.Transfer.Subject)</h1>

        @if (TempData["Message"] is not null)
        {
            <div class="notice">@TempData["Message"]</div>
        }

        <div class="detail-grid admin-detail">
            <div><span>Sender</span><strong>@Model.Transfer.SenderEmail</strong></div>
            <div><span>Recipient</span><strong>@Model.Transfer.RecipientEmail</strong></div>
            <div><span>Created</span><strong>@Model.Transfer.CreatedDate.ToLocalTime()</strong></div>
            <div><span>Expires</span><strong>@Model.Transfer.ExpirationDate.ToLocalTime()</strong></div>
            <div><span>Downloads</span><strong>@Model.Transfer.DownloadCount</strong></div>
            <div><span>Status</span><strong>@Model.Transfer.Status</strong></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Transfer.Message))
        {
            <div class="admin-card"><h2>Message</h2><p>@Model.Transfer.Message</p></div>
        }

        <div class="admin-card">
            <h2>Files</h2>
            <table class="admin-table">
                <thead><tr><th>File</th><th>Size</th><th>SHA-256</th><th>Download</th></tr></thead>
                <tbody>
                @foreach (var f in Model.Files)
                {
                    <tr>
                        <td>@f.OriginalFileName</td>
                        <td>@Size(f.FileSizeBytes)</td>
                        <td class="hash">@f.Sha256Hash</td>
                        <td><a class="mini-button" href="/Transfer/File/@Model.Transfer.DownloadToken/@f.FileId">Download</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="admin-card">
            <h2>Actions</h2>
            <div class="action-row">
                <form method="post" action="/Admin/Transfer/@Model.Transfer.TransferId/Extend">
                    <input type="number" name="days" min="1" max="30" value="7" />
                    <button type="submit">Extend Expiration</button>
                </form>

                <form method="post" action="/Admin/Transfer/@Model.Transfer.TransferId/Resend">
                    <button type="submit">Resend Email</button>
                </form>

                <form method="post" action="/Admin/Transfer/@Model.Transfer.TransferId/Disable">
                    <button type="submit" class="warning">Disable Link</button>
                </form>

                <form method="post" action="/Admin/Transfer/@Model.Transfer.TransferId/Delete" onsubmit="return confirm('Delete this transfer record? This does not delete physical files yet.');">
                    <button type="submit" class="danger">Delete Record</button>
                </form>
            </div>
        </div>
    </div>
</section>













