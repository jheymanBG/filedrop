@model FileDrop.Web.Models.AuthorizationStatusViewModel

<section class="admin-shell">
    <partial name="_AdminNav" />

    <div class="admin-main">
        <h1>Enterprise Authorization</h1>

        @if (TempData["Message"] is not null)
        {
            <div class="notice">@TempData["Message"]</div>
        }

        <div class="metric-grid">
            <div class="metric"><span>Mode</span><strong>@Model.Mode</strong></div>
            <div class="metric"><span>Signed In</span><strong>@(Model.IsSignedIn ? "Yes" : "No")</strong></div>
            <div class="metric"><span>Effective Roles</span><strong>@Model.EffectiveRoles.Count</strong></div>
        </div>

        <div class="admin-card">
            <h2>Configure Entra Groups</h2>
            <form method="post" action="/Admin/Authorization/Save">
                <label for="mode">Authorization Mode</label>
                <select id="mode" name="mode">
                    <option value="TemporaryAdminKey" selected="@(Model.Mode == "TemporaryAdminKey")">Temporary Admin Key</option>
                    <option value="Hybrid" selected="@(Model.Mode == "Hybrid")">Hybrid</option>
                    <option value="EntraGroups" selected="@(Model.Mode == "EntraGroups")">Entra Groups</option>
                </select>

                <label for="adminGroupObjectId">Administrator Group Object ID</label>
                <input id="adminGroupObjectId" name="adminGroupObjectId" value="@Model.AdminGroupObjectId" />

                <label for="auditorGroupObjectId">Auditor Group Object ID</label>
                <input id="auditorGroupObjectId" name="auditorGroupObjectId" value="@Model.AuditorGroupObjectId" />

                <label for="helpDeskGroupObjectId">Help Desk Group Object ID</label>
                <input id="helpDeskGroupObjectId" name="helpDeskGroupObjectId" value="@Model.HelpDeskGroupObjectId" />

                <div class="checkbox-card">
                    <label class="checkbox-label">
                        <input type="checkbox" name="requireAdminGroupForAdminPortal" value="true" @(Model.RequireAdminGroupForAdminPortal ? "checked" : "") />
                        <span>
                            <strong>Require Entra Admin Group for Admin Portal</strong>
                            <small>Only enable after Microsoft sign-in and admin consent are fully working.</small>
                        </span>
                    </label>
                    <input type="hidden" name="requireAdminGroupForAdminPortal" value="false" />
                </div>

                <button type="submit">Save Authorization Settings</button>
            </form>
        </div>

        <div class="admin-card">
            <h2>Current User</h2>
            <table class="admin-table">
                <tbody>
                    <tr><th>User</th><td>@Model.UserName</td></tr>
                    <tr><th>Email</th><td>@Model.UserEmail</td></tr>
                    <tr><th>Effective Roles</th><td>@string.Join(", ", Model.EffectiveRoles)</td></tr>
                    <tr><th>Group Claim Count</th><td>@Model.GroupClaims.Count</td></tr>
                </tbody>
            </table>
        </div>

        <div class="admin-card">
            <h2>Recent Authorization Events</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Required Role</th>
                        <th>Authorized</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.RecentEvents)
                {
                    <tr>
                        <td>@e.CreatedDate.ToLocalTime()</td>
                        <td>@e.UserEmail</td>
                        <td>@e.RequiredRole</td>
                        <td><span class="badge @(e.Authorized ? "clean" : "failed")">@(e.Authorized ? "Yes" : "No")</span></td>
                        <td>@e.Reason</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>


