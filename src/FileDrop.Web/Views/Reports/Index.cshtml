@model FileDrop.Web.Models.ReportsIndexViewModel

<section class="admin-shell">
    <aside class="admin-nav">
        <h2>FileDrop Admin</h2>
        <a href="/Admin">Dashboard</a>
        <a href="/Admin/Transfers">Transfers</a>
        <a href="/Admin/Audit">Audit Log</a>
        <a href="/Admin/Health">Health</a>
        <a href="/Admin/Settings">Settings</a><a href="/Admin/AdminUsers">Admin Users</a><a href="/Admin/Uploads">Upload Manager</a>
        <a href="/Admin/Deployment">Deployment</a>
        <a class="active" href="/Admin/Reports">Reports</a>
        <a href="/">User Home</a>
        <form method="post" action="/Admin/Logout" class="admin-logout-form"><button type="submit">Admin Logout</button></form>
    </aside>

    <div class="admin-main">
        <h1>Reports & Exports</h1>
        <p class="muted">Download FileDrop reports as CSV files for Excel, auditing, storage review, or records retention.</p>

        <div class="report-grid">
            <div class="report-card">
                <h2>Transfers</h2>
                <p>All transfers with sender, recipient, status, expiration, file count, total size, and download count.</p>
                <a class="button" href="/Admin/Reports/Transfers.csv">Download CSV</a>
            </div>

            <div class="report-card">
                <h2>Files</h2>
                <p>All uploaded files with size, hash, storage path, sender, recipient, subject, and upload date.</p>
                <a class="button" href="/Admin/Reports/Files.csv">Download CSV</a>
            </div>

            <div class="report-card">
                <h2>Audit Log</h2>
                <p>Recent audit events including uploads, downloads, exports, admin actions, and cleanup actions.</p>
                <a class="button" href="/Admin/Reports/Audit.csv">Download CSV</a>
            </div>

            <div class="report-card">
                <h2>Storage Summary</h2>
                <p>Storage root, file counts, folder counts, total bytes, active bytes, and expired bytes.</p>
                <a class="button" href="/Admin/Reports/Storage.csv">Download CSV</a>
            </div>
        </div>

        <div class="admin-card">
            <h2>Notes</h2>
            <ul>
                <li>CSV files open directly in Microsoft Excel.</li>
                <li>Report exports are written to the audit log.</li>
                <li>Large file inventories may take a few seconds to generate.</li>
            </ul>
        </div>
    </div>
</section>








