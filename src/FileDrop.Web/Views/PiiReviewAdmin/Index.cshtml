@model IReadOnlyList<FileDrop.Web.Models.PiiReviewRequestRecord>
@{
    ViewData["Title"] = "PII review queue";
    var findings = ViewBag.FindingMap as Dictionary<long, IReadOnlyList<FileDrop.Web.Models.PiiScanFindingRecord>>
        ?? new Dictionary<long, IReadOnlyList<FileDrop.Web.Models.PiiScanFindingRecord>>();
}
<div class="container py-4">
<h1>Pending PII approvals</h1>
<p>Approval creates a secure transfer after a clean malware scan. The recipient is captured when the review is submitted and cannot be edited by an administrator.</p>
@if (TempData["Message"] is string message) { <div class="alert alert-info">@message</div> }
@foreach (var review in Model) {
<div class="card mb-3"><div class="card-body">
<h2 class="h5">Review #@review.ReviewId</h2>
<p><strong>Upload:</strong> @review.UploadId</p>
<p>
    <a class="btn btn-outline-primary"
       href="/Admin/Pii/Reviews/@review.ReviewId/File">
        Download Uploaded File for Review
    </a>
</p>
<p><strong>Requested by:</strong> @review.RequestedBy</p>
<p><strong>Explanation:</strong> @review.Justification</p>
<h3 class="h6">Masked findings</h3>
@if (findings.TryGetValue(review.ReviewId, out var items) && items.Count > 0) {
  <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Category</th><th>Confidence</th><th>Page</th><th>Masked evidence</th></tr></thead><tbody>
  @foreach (var item in items) { <tr><td>@item.Category</td><td>@item.Confidence</td><td>@item.PageNumber</td><td>@item.MaskedEvidence</td></tr> }
  </tbody></table></div>
} else { <p>No detailed findings recorded.</p> }
<form method="post" action="/Admin/Pii/Reviews/ApproveRelease">@Html.AntiForgeryToken()
<input type="hidden" name="reviewId" value="@review.ReviewId" />
<label class="form-label">Original recipient email (read-only)</label>
<input class="form-control mb-2" type="email" value="@review.RecipientEmail" readonly disabled />
@if (string.IsNullOrWhiteSpace(review.RecipientEmail)) { <p class="text-danger">Recipient not recorded for this earlier review. Approval is blocked; reject or delete this review instead.</p> }
<label class="form-label">Expiration (days)</label>
<input class="form-control mb-2" type="number" name="expirationDays" min="1" max="30" value="7" required />
<label class="form-label">Maximum downloads (optional)</label>
<input class="form-control mb-2" type="number" name="maxDownloads" min="1" />
<label class="form-label"><input type="checkbox" name="disableAfterFirstDownload" value="true" /> One-time download</label>
<div class="mb-2"></div>
<label class="form-label">Approval justification (minimum 15 characters)</label>
<textarea class="form-control mb-2" name="reason" required minlength="15" maxlength="2000"></textarea>
<button class="btn btn-success" type="submit" disabled="@(string.IsNullOrWhiteSpace(review.RecipientEmail))">Approve &amp; Release</button>
</form>
<form method="post" action="/Admin/Pii/Reviews/Decide" class="mt-3">@Html.AntiForgeryToken()
<input type="hidden" name="reviewId" value="@review.ReviewId" />
<input type="hidden" name="decision" value="Rejected" />
<label class="form-label">Rejection reason</label>
<textarea class="form-control mb-2" name="reason" required minlength="15" maxlength="2000"></textarea>
<button class="btn btn-outline-danger" type="submit">Reject</button>
</form>
<form method="post" action="/Admin/Pii/Reviews/Delete" class="mt-3"
      onsubmit="return confirm('Remove review #@review.ReviewId from the pending queue? The held file remains blocked.');">
@Html.AntiForgeryToken()
<input type="hidden" name="reviewId" value="@review.ReviewId" />
<label class="form-label">Deletion reason (minimum 15 characters)</label>
<textarea class="form-control mb-2" name="reason" required minlength="15" maxlength="2000"></textarea>
<button class="btn btn-outline-danger" type="submit">Delete review (keep file blocked)</button>
</form>
</div></div>
}
@if (Model.Count == 0) { <p>No pending requests.</p> }
</div>
