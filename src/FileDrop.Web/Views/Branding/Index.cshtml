@model FileDrop.Web.Models.BrandingViewModel

<section class="admin-shell">
    <partial name="_AdminNav" />

    <div class="admin-main">
        <h1>Branding</h1>

        @if (TempData["Message"] is not null)
        {
            <div class="notice">@TempData["Message"]</div>
        }

        <div class="admin-card">
            <h2>Current Logo</h2>

            @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
            {
                <div class="logo-preview">
                    <img src="@Model.LogoPath?v=@DateTime.Now.Ticks" alt="Current FileDrop logo" />
                </div>

                <form method="post" action="/Admin/Branding/Logo/Remove">
                    <button type="submit" class="danger">Remove Logo</button>
                </form>
            }
            else
            {
                <p class="muted">No logo uploaded. The BG placeholder is hidden until you upload an official logo.</p>
            }

            <form method="post" action="/Admin/Branding/Logo" enctype="multipart/form-data">
                <label for="logo">Upload Logo</label>
                <input id="logo" name="logo" type="file" accept=".png,.jpg,.jpeg,.webp,.svg" />
                <button type="submit">Upload Logo</button>
            </form>
        </div>

        <div class="admin-card">
            <h2>Text Branding</h2>

            <form method="post" action="/Admin/Branding/Text">
                <label for="OrganizationName">Organization Name</label>
                <input id="OrganizationName" name="OrganizationName" value="@Model.OrganizationName" />

                <label for="ApplicationTitle">Application Title</label>
                <input id="ApplicationTitle" name="ApplicationTitle" value="@Model.ApplicationTitle" />

                <label for="DepartmentName">Department Name</label>
                <input id="DepartmentName" name="DepartmentName" value="@Model.DepartmentName" />

                <button type="submit">Save Branding</button>
            </form>
        </div>
    </div>
</section>






