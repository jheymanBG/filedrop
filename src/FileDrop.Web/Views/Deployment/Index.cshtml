@model List<System.IO.DirectoryInfo>

<section class="admin-shell">
    <aside class="admin-nav">
        <h2>FileDrop Admin</h2>
        <a href="/Admin">Dashboard</a>
        <a href="/Admin/Transfers">Transfers</a>
        <a href="/Admin/Audit">Audit Log</a>
        <a href="/Admin/Health">Health</a>
        <a href="/Admin/Settings">Settings</a>
        <a class="active" href="/Admin/Deployment">Deployment</a>
        <a href="/">User Home</a>
        <form method="post" action="/Admin/Logout" class="admin-logout-form"><button type="submit">Admin Logout</button></form>
    </aside>

    <div class="admin-main">
        <h1>Deployment</h1>

        @if (TempData["Message"] is not null)
        {
            <div class="notice">@TempData["Message"]</div>
        }

        <div class="admin-card">
            <h2>Deployment Tools</h2>
            <p>Use these PowerShell scripts from an elevated PowerShell session on the server.</p>

            <pre class="code-block">C:\Build\FileDrop_v1_starter\DeployTools\Backup-FileDrop.ps1

C:\Build\FileDrop_v1_starter\DeployTools\List-FileDrop-Backups.ps1

C:\Build\FileDrop_v1_starter\DeployTools\Restore-FileDrop.ps1 -BackupFolder "C:\Build\FileDrop_v1_starter\Backups\YYYYMMDD-HHMMSS"

C:\Build\FileDrop_v1_starter\DeployTools\Deploy-FileDrop-Safe.ps1</pre>
        </div>

        <div class="admin-card">
            <h2>Recent Backups</h2>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Backup</th>
                        <th>Created</th>
                        <th>Path</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var backup in Model)
                {
                    <tr>
                        <td><strong>@backup.Name</strong></td>
                        <td>@backup.LastWriteTime</td>
                        <td class="hash">@backup.FullName</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>





